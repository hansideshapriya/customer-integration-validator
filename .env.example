# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real credentials.

# --- Source system (the CRM you're pulling customer data FROM) ---
SOURCE_API_URL=http://127.0.0.1:8001
SOURCE_API_KEY=demo-source-key
SOURCE_PAGE_SIZE=25

# --- Destination system (the system you're importing customers INTO) ---
DESTINATION_API_URL=http://127.0.0.1:8002
DESTINATION_API_TOKEN=demo-destination-token

# --- Networking behavior ---
REQUEST_TIMEOUT_SECONDS=5
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=0.5

# --- Business rules ---
MAX_NOTES_LENGTH=500

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/integration.log

# --- Mock API behavior (mock_apis/ only -- has no effect on real APIs) ---
# Set to a decimal like 0.1 to make ~10% of source-API requests fail with
# a 500, to demo retry/backoff behavior. Leave at 0 for a stable demo.
MOCK_SOURCE_FAILURE_RATE=0

# --- Deployment mode ---
# true (default): run the bundled mock APIs in-process, so the app works
# as a single deployable process with zero external dependencies.
# false: skip starting the mocks; source/destination URLs must then
# point at a real system.
USE_BUNDLED_MOCK_APIS=true